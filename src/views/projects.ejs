
<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
<ul>
    
    <% projects.forEach(project => { %>
        <li>
            <h3><%= project.title %></h3>
            <p><%= project.description %></p>
            <p>Location: <%= project.location %></p>
            <p>Date: <%= project.project_date %></p>
        </li>
    <% }); %>
</ul>
</main>
<%- include('partials/footer') %>